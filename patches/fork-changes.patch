+                    state.requery();
+                    state.bindLong(1, uid);
+                    state.bindInteger(2, mids.get(i));
+                    state.bindInteger(3, now);
+                    state.step();
+                }
+                state.dispose();
+                database.commitTransaction();
+            } catch (Exception e) {
+                FileLog.e(e);
+            }
+        });
+    }
